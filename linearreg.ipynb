   "source": [
    "## Use a dictionary to count the frquency of elements in a list\n",
    "lst = [1,1,1,2,2,3,3,3,3,3,4,4,4,4,5,6]\n",
    "frq = {}\n",
    "for i in lst:\n",
    "    if i in frq:\n",
    "        frq[i]+=1\n",
    "    else:\n",
    "        frq[i] = 1\n",
    "print(frq)"
   ]
