   "source": [
    "def check(password):\n",
    "    if len(password)<8:\n",
    "        return False\n",
    "    if not any(char.isdigit() for char in password):\n",
    "        return False\n",
    "    return True\n",
    "    \n",
    "print(check(\"Aryan@227\"))"
   ]
  },
